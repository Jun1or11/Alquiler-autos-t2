<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AppLabel">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text</item>
    </style>

    <style name="AppInput">
        <item name="android:background">@drawable/bg_app_input</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textColorHint">@color/app_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="AppSpinner">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="AppButton">
        <item name="android:background">@drawable/bg_app_primary</item>
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/app_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="AppButton.Secondary" parent="AppButton">
        <item name="android:background">@drawable/bg_app_secondary</item>
        <item name="backgroundTint">@color/app_soft</item>
        <item name="android:backgroundTint">@color/app_soft</item>
        <item name="android:textColor">@color/app_secondary_text</item>
    </style>

    <style name="AppResult">
        <item name="android:background">@drawable/bg_app_card</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
