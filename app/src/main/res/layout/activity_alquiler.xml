<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/AppTitle"
            android:id="@+id/tvTituloAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generar Contrato de Alquiler"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cliente:" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spClienteAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recepcionista de ventas:" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spRecepcionistaAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehículo:" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spVehiculoAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reserva (opcional; seleccionarla completa cliente y vehículo):" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spReservaAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etFechaInicioAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha Inicio (Toca para seleccionar)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etFechaFinAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha Fin (Toca para seleccionar)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etMontoTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monto Total (S/)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <Button
                style="@style/AppButton"
                android:id="@+id/btnGenerarContrato"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Generar Contrato y Comprobante" />

            <Button
                style="@style/AppButton.Secondary"
                android:id="@+id/btnVolverInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Volver al inicio" />
        </LinearLayout>

        <TextView
            style="@style/AppResult"
            android:id="@+id/tvResultadoAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:padding="12dp"
            android:textSize="15sp"
            android:minLines="4"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false" />

    </LinearLayout>
</ScrollView>
