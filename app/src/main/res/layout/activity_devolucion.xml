<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/AppTitle"
            android:id="@+id/tvTituloDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inspección Física y Devolución"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inspector de flota:" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spInspectorDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contrato en alquiler:" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spContratoDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:id="@+id/tvVehiculoDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="El vehículo se completa al elegir el contrato."
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etFechaDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha de Devolución (Toca para seleccionar)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etObservacionesInspeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones de Inspección Física"
            android:inputType="textMultiLine"
            android:lines="3"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Penalidades (Opcional):"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etMotivoPenalidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Motivo (ej: Rayón en puerta, retraso)"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etMontoPenalidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monto de Penalidad (S/)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <Button
                style="@style/AppButton"
                android:id="@+id/btnFinalizarDevolucion"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Registrar Inspección y Liberar Unidad" />

            <Button
                style="@style/AppButton.Secondary"
                android:id="@+id/btnVolverInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Volver al inicio" />
        </LinearLayout>

        <TextView
            style="@style/AppResult"
            android:id="@+id/tvResultadoDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:padding="12dp"
            android:textSize="15sp"
            android:minLines="4"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false" />

    </LinearLayout>
</ScrollView>
