<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvTituloMenu"
            style="@style/AppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistema de Gestión de Alquiler de Vehículos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBienvenidoUsuario"
            style="@style/AppResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usuario activo"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnIrRegistroVehiculo"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Vehículo"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrRegistroUsuario"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Usuario y Rol"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrReserva"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reservas de Vehículos"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrAlquiler"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generar Alquiler y Comprobante"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrMantenimiento"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orden de Mantenimiento"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrDevolucion"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devolución e Inspección"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrPoliza"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pólizas de Seguro"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrReportes"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Módulo de Reportes"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnCerrarSesion"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar Sesión"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
