<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/AppTitle"
            android:id="@+id/tvTituloPoliza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro de Póliza de Seguro"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spVehiculoPoliza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etNumeroPoliza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número de Póliza (ej: POL-2026-001)"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:id="@+id/tvLabelCobertura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo Cobertura:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spCoberturaPoliza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etMontoCobertura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monto de Cobertura (S/)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etFechaVencimientoPoliza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha Vencimiento (Toca para seleccionar)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <Button
                style="@style/AppButton"
                android:id="@+id/btnGuardarPoliza"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Registrar Póliza de Seguro" />

            <Button
                style="@style/AppButton.Secondary"
                android:id="@+id/btnVolverInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Volver al inicio" />
        </LinearLayout>

        <TextView
            style="@style/AppResult"
            android:id="@+id/tvResultadoPoliza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:padding="12dp"
            android:textSize="15sp"
            android:minLines="4"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false" />

    </LinearLayout>
</ScrollView>
