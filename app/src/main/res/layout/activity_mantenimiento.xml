<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orden de Mantenimiento"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehículo disponible:" />

        <Spinner
            android:id="@+id/spVehiculoMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de Mantenimiento:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spTipoMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etFechaMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha (Toca para seleccionar)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etCostoMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Costo del servicio (S/)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnGuardarMantenimiento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Registrar Orden de Mantenimiento" />

            <Button
                android:id="@+id/btnVolverInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Volver al inicio" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultadoMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFEFEF"
            android:padding="12dp"
            android:textSize="15sp"
            android:minLines="4"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false" />

    </LinearLayout>
</ScrollView>
