<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/AppTitle"
            android:id="@+id/tvTituloReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reserva de Vehículo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spClienteReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <Spinner
            style="@style/AppSpinner"
            android:id="@+id/spVehiculoReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            style="@style/AppLabel"
            android:id="@+id/tvVehiculoSeleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/contenedorVehiculosReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etFechaReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha de Reserva (Toca para seleccionar)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <EditText
            style="@style/AppInput"
            android:id="@+id/etMontoAdelanto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monto Adelanto (S/)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <Button
                style="@style/AppButton"
                android:id="@+id/btnRegistrarReserva"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Generar Reserva, Comprobante y Constancia" />

            <Button
                style="@style/AppButton.Secondary"
                android:id="@+id/btnVolverInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Volver al inicio" />
        </LinearLayout>

        <TextView
            style="@style/AppResult"
            android:id="@+id/tvResultadoReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:padding="12dp"
            android:textSize="15sp"
            android:minLines="4"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false" />

    </LinearLayout>
</ScrollView>
